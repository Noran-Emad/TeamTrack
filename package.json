{
  "name": "teamtrack",
  "version": "1.0.0",
  "private": true,
  "description": "TeamTrack collaborative learning assessment app",
  "engines": { "node": ">=18" },
  "scripts": {
    "dev": "concurrently -k \"npm:backend\" \"npm:vite\"",
    "vite": "vite --host 0.0.0.0",
    "backend": "node server/server.js",
    "build": "vite build",
    "start": "npm run build && node server/server.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "vite": "^6.3.5"
  }
}
